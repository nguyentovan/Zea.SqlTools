<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PortablePythonRoot)' != ''">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <DebugType>embedded</DebugType>
    <DefineConstants>$(DefineConstants);ZEA_PORTABLE_PYTHON</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(PortablePythonRoot)' != ''">
    <Content Include="$(PortablePythonRoot)\**\*" LinkBase="python" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Formatters/RightWay/LICENSE.txt" TargetPath="licenses/RightWay.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Update="SqlFluff*.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
